{
  "name": "radiojournal-ui",
  "version": "0.7.3",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/nprogress": "0.2.3",
    "daisyui": "5.7.50",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.0",
    "globals": "17.12.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.3"
  },
  "packageManager": "pnpm@12.17.0",
  "type": "module",
  "dependencies": {
    "chart.js": "4.6.1",
    "dayjs": "1.11.23",
    "nprogress": "0.2.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
